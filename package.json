{
  "name": "fresh-reads",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4321",
    "test": "ASTRO_TELEMETRY_DISABLED=1 node --test tests/*.test.mjs",
    "import:html": "node scripts/import-html.mjs"
  },
  "dependencies": {
    "astro": "^7.4.13",
    "js-yaml": "^5.5.0",
    "marked": "^18.2.1",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
